      },
      {
       "id": "d054858",
       "elType": "widget",
       "widgetType": "heading",
       "settings": {
        "title": "3.2 Cuándo se cobra y cómo se factura",
        "header_size": "h3",
        "typography_typography": "custom",
        "typography_font_size": {
         "unit": "px",
