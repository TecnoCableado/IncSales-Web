       "elType": "widget",
       "widgetType": "text-editor",
       "settings": {
        "editor": "<p>El número de la <a href=\"/precios/\">página de precios</a> es el que sale de tu cuenta: no se le suma un 16% después ni depende del tipo de cambio.</p>"
       },
       "elements": [],
