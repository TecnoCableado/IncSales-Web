          {
           "id": "036aba4",
           "elType": "widget",
           "widgetType": "text-editor",
           "settings": {
            "editor": "<p><strong>9.1 Qué es confidencial.</strong> Tus clientes, precios, márgenes y proveedores, y nuestra información técnica.</p>"
