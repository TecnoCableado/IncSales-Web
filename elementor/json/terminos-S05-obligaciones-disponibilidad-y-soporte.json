      {
       "id": "bfe85d4",
       "elType": "widget",
       "widgetType": "text-editor",
       "settings": {
        "editor": "<p>Se guardan como huella irreversible y nadie las ve: da de baja el mismo día a quien deja la empresa.</p>"
       },
       "elements": [],
       "isInner": false
      },
      {
       "id": "d3d699f",
       "elType": "widget",
       "widgetType": "heading",
       "settings": {
        "title": "5.4 Reglas de WhatsApp y de correo",
        "header_size": "h3",
        "typography_typography": "custom",
        "typography_font_size": {
         "unit": "px",
